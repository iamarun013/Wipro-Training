@{
    ViewData["Title"] = "Home";
}

<div class="container mt-5">
    <div class="text-center">
        <h1 class="display-4 fw-bold text-primary">Inventory Management System</h1>
        <p class="lead mt-3">A Capstone Project by <strong>Arunava Saha</strong> for <strong>Wipro</strong></p>
        <hr class="my-4" />
        <p class="fs-5">Manage your inventory seamlessly — add, update, view, and delete items efficiently through a user-friendly web interface.</p>
        <a class="btn btn-lg btn-success mt-4 px-4" href="/Items">📦 Go to Inventory</a>
    </div>

    <div class="row mt-5 justify-content-center">
        <div class="col-md-4">
            <div class="card shadow-sm border-0">
                <div class="card-body text-center">
                    <h5 class="card-title">Technologies Used</h5>
                    <p class="card-text">ASP.NET Core MVC<br />Entity Framework Core<br />Azure App Service<br />SQL Server<br />Bootstrap</p>
                </div>
            </div>
        </div>

        <div class="col-md-4 mt-4 mt-md-0">
            <div class="card shadow-sm border-0">
                <div class="card-body text-center">
                    <h5 class="card-title">Features</h5>
                    <p class="card-text">✔️ CRUD Operations<br />✔️ Responsive Design<br />✔️ Azure Deployment<br />✔️ Razor Views<br />✔️ MVC Architecture</p>
                </div>
            </div>
        </div>
    </div>
</div>
